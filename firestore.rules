rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo lee y modifica su propio perfil
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /pacts/{id} {
      allow read: if request.auth != null; // TEMPORAL: solo para subir el seed
    }
    match /badges/{id} {
      allow read: if request.auth != null; // TEMPORAL: solo para subir el seed
    }
    match /live_sessions/{id} {
      allow read: if request.auth != null;
      // Solo a tu nombre, contigo como único participante y con valores válidos
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 140
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes > 0
        && request.resource.data.durationMinutes <= 480;
      // Solo el creador edita, solo estos campos y con valores válidos
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['description', 'durationMinutes', 'status', 'endedAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 140
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes > 0
        && request.resource.data.durationMinutes <= 480;
      // Solo el creador borra, y solo si nadie más se ha unido
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && resource.data.participantIds.hasOnly([request.auth.uid]);

      // Pruebas: dentro de la sesión para poder usar su {id}.
      // Solo los participantes las ven; cada uno escribe la suya
      match /proofs/{uid} {
        function isParticipant() {
          return request.auth.uid in
            get(/databases/$(database)/documents/live_sessions/$(id)).data.participantIds;
        }
        allow read: if request.auth != null && isParticipant();
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && isParticipant()
          && request.resource.data.keys().hasOnly(['image', 'createdAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() < 307200
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}